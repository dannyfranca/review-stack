{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "agent": {
      "type": "string"
    },
    "loop": {
      "type": "integer",
      "minimum": 1
    },
    "scope": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": [
              "blocking",
              "important",
              "nit",
              "question",
              "pre_existing"
            ]
          },
          "category": {
            "type": "string",
            "enum": [
              "correctness",
              "security",
              "data_integrity",
              "migration",
              "api_contract",
              "concurrency",
              "performance",
              "test",
              "maintainability",
              "dx"
            ]
          },
          "file": {
            "type": "string"
          },
          "line_start": {
            "type": "integer",
            "minimum": 0
          },
          "line_end": {
            "type": "integer",
            "minimum": 0
          },
          "introduced_by_change": {
            "type": "boolean"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "claim": {
            "type": "string"
          },
          "evidence": {
            "type": "string"
          },
          "suggested_fix": {
            "type": "string"
          },
          "verification_needed": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "severity",
          "category",
          "file",
          "line_start",
          "line_end",
          "introduced_by_change",
          "confidence",
          "claim",
          "evidence",
          "suggested_fix",
          "verification_needed"
        ]
      }
    }
  },
  "required": [
    "agent",
    "loop",
    "scope",
    "summary",
    "findings"
  ]
}