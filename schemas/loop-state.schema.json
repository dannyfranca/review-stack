{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "version": {
      "type": "integer"
    },
    "base": {
      "type": "string"
    },
    "mode": {
      "type": "string",
      "enum": [
        "audit",
        "fix"
      ]
    },
    "current_loop": {
      "type": "integer",
      "minimum": 0
    },
    "max_loops": {
      "type": "integer",
      "minimum": 1
    },
    "started_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "last_updated_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "loops": {
      "type": "array"
    },
    "canonical_findings": {
      "type": "array"
    },
    "resolved_findings": {
      "type": "array"
    },
    "manual_review": {
      "type": "array"
    },
    "deterministic_checks": {
      "type": "array"
    },
    "stop_reason": {
      "type": "string"
    }
  },
  "required": [
    "version",
    "base",
    "mode",
    "current_loop",
    "max_loops",
    "loops",
    "canonical_findings",
    "resolved_findings",
    "manual_review",
    "deterministic_checks"
  ]
}