{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "version": {
      "type": "integer"
    },
    "session_id": {
      "type": "string"
    },
    "review_dir": {
      "type": "string"
    },
    "repo_root": {
      "type": "string"
    },
    "head_sha": {
      "type": "string"
    },
    "base": {
      "type": "string"
    },
    "merge_base": {
      "type": "string"
    },
    "mode": {
      "type": "string",
      "enum": [
        "audit",
        "fix"
      ]
    },
    "current_loop": {
      "type": "integer",
      "minimum": 0
    },
    "max_loops": {
      "type": "integer",
      "minimum": 1
    },
    "started_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "last_updated_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "loops": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "loop": {
            "type": "integer",
            "minimum": 1
          },
          "started_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "finished_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "note": {
            "type": "string"
          },
          "new_confirmed": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "remaining_confirmed": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "fixes_applied": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "deterministic_gates_passing": {
            "type": "string",
            "enum": [
              "true",
              "false",
              "unknown"
            ]
          }
        }
      }
    },
    "canonical_findings": {
      "type": "array"
    },
    "resolved_findings": {
      "type": "array"
    },
    "manual_review": {
      "type": "array"
    },
    "deterministic_checks": {
      "type": "array"
    },
    "stop_reason": {
      "type": "string"
    }
  },
  "required": [
    "version",
    "session_id",
    "review_dir",
    "repo_root",
    "head_sha",
    "base",
    "merge_base",
    "mode",
    "current_loop",
    "max_loops",
    "loops",
    "canonical_findings",
    "resolved_findings",
    "manual_review",
    "deterministic_checks"
  ]
}
